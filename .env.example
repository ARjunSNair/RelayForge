# Copy to .env and adjust. Never commit .env.
# All settings are validated at startup (packages/config).

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL ---
DATABASE_URL=postgresql://relayforge:relayforge_dev@localhost:5432/relayforge
DATABASE_POOL_MAX=10

# --- Queue transport ---
# postgres: local queue table (no cloud needed). servicebus: Azure Service Bus.
QUEUE_TRANSPORT=postgres
QUEUE_NAME=relayforge-deliveries
# With servicebus, prefer managed identity via the namespace...
SERVICE_BUS_NAMESPACE=
# ...or a connection string for local testing against a real namespace.
SERVICE_BUS_CONNECTION_STRING=

# --- Secrets (API + worker) ---
# Base64 32-byte key that encrypts endpoint signing secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SIGNING_SECRET_ENCRYPTION_KEY=

# Development only: allow http:// and private-network destinations (refused in production).
ALLOW_INSECURE_DESTINATIONS=true

# --- API ---
PORT=3000
MAX_EVENT_PAYLOAD_BYTES=262144
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
MAX_REPLAYS_PER_DELIVERY=5

# --- Outbox publisher / retry scheduler ---
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_MS=30000
SCHEDULER_INTERVAL_MS=1000

# --- Delivery worker ---
WORKER_CONCURRENCY=8
DELIVERY_TIMEOUT_MS=10000
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_MAX_EVENT_AGE_HOURS=72
RETRY_BASE_DELAY_MS=5000
RETRY_MAX_DELAY_MS=3600000
